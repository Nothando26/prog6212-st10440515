@model IEnumerable<prog6212_st10440515_poe.Models.ViewModels.ClaimReportViewModel>

<h2>Claims Report</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Lecturer Name</th>
            <th>Total Claims</th>
            <th>Total Hours</th>
            <th>Total Amount</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.LecturerName</td>
                <td>@item.TotalClaims</td>
                <td>@item.TotalHours</td>
                <td>@item.TotalAmount</td>
            </tr>
        }
    </tbody>
</table>
