@model List<prog6212_st10440515_poe.Models.Claim>
@{
    var lecturer = ViewBag.Lecturer;
    ViewBag.Title = "Lecturer Dashboard";
}

<div class="container dashboard-container">

    <h1 class="page-title">Lecturer Dashboard</h1>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-error">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <!-- Personal Details Card -->
    <div class="card info-card">
        <h2>Your Details</h2>
        <p><strong>Full Name:</strong> @lecturer.FullName</p>
        <p><strong>Email:</strong> @lecturer.Email</p>
        <p><strong>Hourly Rate:</strong> @lecturer.HourlyRate.ToString("C")</p>
    </div>

    <!-- Claims List Card -->
    <div class="card info-card">
        <h2>Your Claims</h2>

        @if (!Model.Any())
        {
            <p>No claims submitted yet.</p>
        }
        else
        {
            <table class="table claims-table">
                <thead>
                    <tr>
                        <th>Hours</th>
                        <th>Total</th>
                        <th>Coordinator</th>
                        <th>Manager</th>
                        <th>Status</th>
                        <th>Submitted</th>
                        <th>Document</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var claim in Model)
                    {
                        <tr>
                            <td>@claim.HoursWorked.ToString("N2")</td>
                            <td>@claim.Amount.ToString("C")</td>
                            <td>
                                <span class="badge @(claim.CoordinatorReview.Replace(" ", ""))">@claim.CoordinatorReview</span>
                            </td>
                            <td>
                                <span class="badge @(claim.ManagerReview.Replace(" ", ""))">@claim.ManagerReview</span>
                            </td>
                            <td>@claim.Status</td>
                            <td>@claim.DateSubmitted.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(claim.SupportingDocumentPath))
                                {
                                    <a href="@Url.Content("~/" + claim.SupportingDocumentPath)" target="_blank">View</a>
                                }
                                else
                                {
                                    <span class="not-uploaded">No File</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <a href="@Url.Action("ClaimForm", "Lecturer")" class="btn btn-primary mt-3">Submit New Claim</a>
    </div>
</div>

