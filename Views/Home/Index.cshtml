@{
    ViewBag.Title = "CMCS Home";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body class="home-page">

    <!-- Navbar -->
    <header class="navbar">
        <div class="nav-left">
            <h1 class="system-name">Contract Monthly Claim System</h1>
        </div>
        <nav class="nav-links">
            <a href="@Url.Action("Login", "Account")" class="nav-btn">Login</a>
        </nav>
    </header>

    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-content">
            <h2>Welcome to the CMCS Portal</h2>
            <p>Easily manage and submit your monthly lecturer claims.</p>

            <button class="btn-primary" onclick="location.href='@Url.Action("Login", "Account")'">
                Get Started
            </button>
        </div>

        <div class="hero-image-wrapper">
            <img src="~/images/picture.PNG" alt="Illustration" class="hero-img" />
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <p>Contact us: cmcs@IIEMSA.edu.za</p>
        <p>© 2025 CMCS Website</p>
    </footer>

</body>
</html>
